{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "luna/protocol",
  "title": "Luna shell <-> core protocol",
  "description": "Типы полезной нагрузки JSON-RPC 2.0 между shell и core. Транспорт: stdio, одно JSON-сообщение на строку. Методы и их params/result перечислены в protocol/README.md.",
  "definitions": {
    "ExecutorId": {
      "type": "string",
      "enum": ["claude-code"]
    },
    "ExecutorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "available"],
      "properties": {
        "id": { "$ref": "#/definitions/ExecutorId" },
        "available": { "type": "boolean" },
        "path": { "type": "string" }
      }
    },
    "AppInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "name"],
      "properties": {
        "bundleId": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "TaskContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "$ref": "#/definitions/AppInfo" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "selection": { "type": "string" }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": ["queued", "running", "done", "failed", "cancelled"]
    },
    "TaskErrorKind": {
      "type": "string",
      "enum": ["auth", "rate_limit", "not_installed", "session_not_found", "unknown"]
    },
    "TaskError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "$ref": "#/definitions/TaskErrorKind" },
        "message": { "type": "string" }
      }
    },
    "TaskInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "threadId", "prompt", "status", "executor", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string", "description": "id первой задачи диалога; у задачи без уточнений равен id" },
        "prompt": { "type": "string" },
        "context": { "$ref": "#/definitions/TaskContext" },
        "status": { "$ref": "#/definitions/TaskStatus" },
        "executor": { "$ref": "#/definitions/ExecutorId" },
        "model": { "type": "string", "description": "модель, на которой выполняется задача: как выбрана при отправке, а когда исполнитель сообщил точную — она (алиас sonnet → claude-sonnet-4-6); нет — модель по умолчанию исполнителя ещё не известна" },
        "progress": { "type": "string" },
        "result": { "type": "string" },
        "error": { "$ref": "#/definitions/TaskError" },
        "sessionId": { "type": "string" },
        "createdAt": { "type": "integer", "description": "Unix time, ms" },
        "finishedAt": { "type": "integer", "description": "Unix time, ms" }
      }
    },
    "HelloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executors"],
      "properties": {
        "version": { "type": "string" },
        "executors": {
          "type": "array",
          "items": { "$ref": "#/definitions/ExecutorStatus" }
        }
      }
    },
    "TaskSubmitParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string" },
        "context": { "$ref": "#/definitions/TaskContext" },
        "executor": { "$ref": "#/definitions/ExecutorId" },
        "model": { "type": "string", "description": "модель для этой задачи; строка непрозрачна для протокола, её смысл знает исполнитель (для Claude Code — алиас opus/sonnet/haiku или полный идентификатор); не передана — модель по умолчанию исполнителя; с followUpOf — модель этого уточнения; без неё уточнение продолжается на модели продолжаемой задачи" },
        "followUpOf": { "type": "string", "description": "id задачи диалога, которую продолжает уточнение; вместе с ним context и executor не передаются, model — можно (модель уточнения)" }
      }
    },
    "TaskSubmitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task"],
      "properties": {
        "task": { "$ref": "#/definitions/TaskInfo" }
      }
    },
    "TaskCancelParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": {
        "taskId": { "type": "string" }
      }
    },
    "TaskListParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "description": "подстрока запроса или ответа задачи без учёта регистра; пустая — обычный список" }
      }
    },
    "TaskListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/TaskInfo" }
        }
      }
    },
    "TaskDeleteParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": {
        "taskId": { "type": "string", "description": "любая задача диалога: удаляется весь диалог" }
      }
    },
    "TaskDeleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleted"],
      "properties": {
        "deleted": {
          "type": "array",
          "description": "id удалённых задач",
          "items": { "type": "string" }
        }
      }
    },
    "TaskClearResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleted"],
      "properties": {
        "deleted": {
          "type": "array",
          "description": "id задач удалённых диалогов: всех, где нет задачи queued или running",
          "items": { "type": "string" }
        }
      }
    },
    "TaskEventParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task"],
      "properties": {
        "task": { "$ref": "#/definitions/TaskInfo" }
      }
    },
    "AgentState": {
      "type": "string",
      "description": "working — агент занят; waiting — ждёт ответа или разрешения человека; idle — ход завершён",
      "enum": ["working", "waiting", "idle"]
    },
    "AgentHostKind": {
      "type": "string",
      "description": "ide — редактор с расширением агента; terminal — окно терминала; unknown — хозяин процесса не определён",
      "enum": ["ide", "terminal", "unknown"]
    },
    "AgentHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/definitions/AgentHostKind" },
        "name": { "type": "string", "description": "имя приложения: «Visual Studio Code», «iTerm2»" },
        "appPath": { "type": "string", "description": "путь к бандлу приложения-хозяина, если его удалось найти" },
        "workspace": { "type": "string", "description": "папка, открытая в окне редактора-хозяина; рабочая директория сессии бывает глубже неё" },
        "tty": { "type": "string", "description": "терминал сессии, например /dev/ttys003" }
      }
    },
    "AgentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent", "pid", "cwd", "project", "state", "host", "startedAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "description": "id сессии агента" },
        "agent": { "type": "string", "description": "чей это агент: «claude-code». Строка, а не перечисление: оболочка показывает и незнакомых агентов" },
        "pid": { "type": "integer" },
        "cwd": { "type": "string" },
        "project": { "type": "string", "description": "имя проекта: последняя часть cwd" },
        "title": { "type": "string", "description": "о чём сессия: заголовок от агента, а пока его нет — последний запрос человека" },
        "state": { "$ref": "#/definitions/AgentState" },
        "waitingFor": { "type": "string", "description": "чего ждёт агент в состоянии waiting, словами агента" },
        "activity": { "type": "string", "description": "что агент делает сейчас: «читает main.ts»" },
        "trail": {
          "type": "array",
          "description": "несколько последних шагов сессии, старые первыми: по ним оболочка рисует превью работы, не запрашивая ленту",
          "items": { "$ref": "#/definitions/AgentStep" }
        },
        "host": { "$ref": "#/definitions/AgentHost" },
        "openUrl": { "type": "string", "description": "ссылка, по которой приложение-хозяин открывает именно эту сессию; есть не у всех хозяев" },
        "startedAt": { "type": "integer", "description": "Unix time, ms" },
        "updatedAt": { "type": "integer", "description": "Unix time, ms: последняя смена состояния или запись в журнале сессии" }
      }
    },
    "AgentStepKind": {
      "type": "string",
      "description": "prompt — запрос человека; tool — вызов инструмента; text — текст агента",
      "enum": ["prompt", "tool", "text"]
    },
    "AgentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "at"],
      "properties": {
        "kind": { "$ref": "#/definitions/AgentStepKind" },
        "text": { "type": "string" },
        "tool": { "type": "string", "description": "у шага tool — род инструмента: read, edit, write, shell, search, web, agent, plan, ask, skill, mcp, other. Строка, а не перечисление: незнакомый род оболочка показывает общим значком" },
        "target": { "type": "string", "description": "у шага tool — над чем работает инструмент, коротко: имя файла, подпись команды, запрос" },
        "at": { "type": "integer", "description": "Unix time, ms" }
      }
    },
    "AgentListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/definitions/AgentSession" }
        }
      }
    },
    "AgentStepsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": { "type": "string" },
        "detail": { "type": "boolean", "description": "true — подробная лента для окна сессии: больше шагов, текст длиннее и с переносами строк" }
      }
    },
    "AgentStepsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "description": "последние шаги сессии, старые первыми",
          "items": { "$ref": "#/definitions/AgentStep" }
        }
      }
    },
    "AgentsEventParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions"],
      "properties": {
        "sessions": {
          "type": "array",
          "description": "полный список живых сессий",
          "items": { "$ref": "#/definitions/AgentSession" }
        }
      }
    }
  }
}
